:80 {
	root * /srv
	encode zstd gzip

	# Hugo fingerprints these filenames, so they can be cached forever.
	@immutable path /css/* /js/* /fonts/* /generated/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@html path *.html /
	header @html Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	try_files {path}/index.html {path} {path}.html /404.html
	file_server
}
